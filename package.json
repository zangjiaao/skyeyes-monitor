{
  "name": "skyeyes-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Daily X and web monitor for tracked names, exported to Excel and email.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  }
}
